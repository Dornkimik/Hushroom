PORT=3000
HOST=127.0.0.1
# First startup only: create an administrator account before opening registration.
# Username: 3-24 letters/numbers/underscores. Password: 15-128 characters.
# After creation, remove these bootstrap credentials from the environment.
ADMIN_USERNAME=
ADMIN_PASSWORD=
# For public hosting, set your exact HTTPS URL and enable secure cookies.
# ORIGIN=https://chat.example.com
# SECURE_COOKIES=true
# List ONLY actual trusted ingress IPs/CIDRs and trusted intermediate proxies.
# The ingress must append/sanitize X-Forwarded-For and restrict direct access.
# Never use a trust-all network. No list means forwarding headers are ignored.
# TRUSTED_PROXY_ADDRESSES=127.0.0.1,::1
# Railway needs its actual ingress networks, not the loopback example above.

# Accounts, main rooms, bans, and feedback need persistent disk storage.
# On Railway, attach a volume (for example at /data) and leave DATA_DIR unset:
# the app automatically uses RAILWAY_VOLUME_MOUNT_PATH.
# Otherwise set DATA_DIR to a directory on persistent storage.
# DATA_DIR=/data

# Encrypted image lifetime in seconds (1–86400); default: 24 hours.
# ATTACHMENT_TTL_SECONDS=86400
