  <PropertyGroup>
    <ProjectGuid>{E2F357D9-7C4A-4F22-AD48-7AB8AB214345}</ProjectGuid>
    <ProjectHome>.</ProjectHome><ProjectView>ShowAllFiles</ProjectView>
    <StartupFile>server.mjs</StartupFile><WorkingDirectory>.</WorkingDirectory>
